@using PortalTransparencia.Models

<nav class="menu-horizontal">

    @foreach (var menu in Menus)
    {
        if (menu.SubMenus?.Any() == true)
        {
            <div class="menu-item"
                 @onmouseenter="() => AbrirMenu(menu.Titulo)"
                 @onmouseleave="CerrarMenu">

                <button class="menu-btn">
                    @menu.Titulo
                </button>

                @if (MenuAbierto == menu.Titulo)
                {
                    <div class="submenu">

                        @foreach (var sub in menu.SubMenus)
                        {
                            <a href="@sub.Url"
                               target="_blank"
                               rel="noopener noreferrer">
                                @sub.Titulo
                            </a>
                        }

                    </div>
                }

            </div>
        }
        else
        {
            <div class="menu-item">
                <a class="menu-btn"
                   href="@menu.Url"
                   target="_blank"
                   rel="noopener noreferrer">
                    @menu.Titulo
                </a>
            </div>
        }
    }

</nav>

@code {

    private string? MenuAbierto;

    private void AbrirMenu(string titulo)
    {
        MenuAbierto = titulo;
    }

    private void CerrarMenu()
    {
        MenuAbierto = null;
    }

